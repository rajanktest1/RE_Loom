{
  "name": "realestate-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "seed": "npm run seed:auth && npm run seed:inventory && npm run seed:supply-chain && npm run seed:crm",
    "seed:auth": "cd services/auth-service && npx ts-node src/seed.ts",
    "seed:inventory": "cd services/inventory-service && npx ts-node src/seed.ts",
    "seed:supply-chain": "cd services/supply-chain-service && npx ts-node src/seed.ts",
    "seed:crm": "cd services/crm-service && npx ts-node src/seed.ts",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
