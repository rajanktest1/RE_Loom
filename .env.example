# Auth Service
AUTH_SERVICE_PORT=4001
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Inventory Service
INVENTORY_SERVICE_PORT=4002

# Supply Chain Service
SUPPLY_CHAIN_SERVICE_PORT=4003

# CRM Service
CRM_SERVICE_PORT=4004

# Notification Service
NOTIFICATION_SERVICE_PORT=4005

# Document Service
DOCUMENT_SERVICE_PORT=4006

# API Gateway
GATEWAY_PORT=4000

# MongoDB
MONGO_AUTH_URI=mongodb://localhost:27017/realestate_auth
MONGO_INVENTORY_URI=mongodb://localhost:27017/realestate_inventory
MONGO_SUPPLY_CHAIN_URI=mongodb://localhost:27017/realestate_supply_chain
MONGO_CRM_URI=mongodb://localhost:27017/realestate_crm
MONGO_NOTIFICATION_URI=mongodb://localhost:27017/realestate_notification
MONGO_DOCUMENT_URI=mongodb://localhost:27017/realestate_document

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=realestate-documents

# Frontend
VITE_API_URL=http://localhost:4000/api
