# =============================================================================
# Multi-stage Dockerfile for all Node.js microservices
# Build: docker build -f docker/Dockerfile.service \
#          --build-arg SERVICE_NAME=inventory-service \
#          --build-arg SERVICE_PORT=4002 .
# =============================================================================

# --- Stage 1: Builder ---
FROM node:20-alpine AS builder

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

WORKDIR /app

# Install turbo globally for pruning
RUN npm install -g turbo@2

# Copy root package files for dependency resolution
COPY package.json package-lock.json turbo.json tsconfig.base.json ./

# Copy all workspace package.json files (needed for npm install)
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/database/package.json ./packages/database/
COPY packages/rabbitmq-client/package.json ./packages/rabbitmq-client/

# Copy service and gateway package.json
COPY services/auth-service/package.json ./services/auth-service/
COPY services/inventory-service/package.json ./services/inventory-service/
COPY services/supply-chain-service/package.json ./services/supply-chain-service/
COPY services/crm-service/package.json ./services/crm-service/
COPY services/notification-service/package.json ./services/notification-service/
COPY services/document-service/package.json ./services/document-service/
COPY apps/gateway/package.json ./apps/gateway/

# Install all dependencies (workspace-aware)
RUN npm ci --ignore-scripts

# Copy source code
COPY packages/ ./packages/
COPY services/ ./services/
COPY apps/gateway/ ./apps/gateway/

# Build shared packages first, then the target service
RUN turbo build --filter=@realestate/${SERVICE_NAME}

# --- Stage 2: Collect dist ---
FROM builder AS dist-collector
ARG SERVICE_NAME
RUN mkdir -p /dist/packages/shared-types /dist/packages/shared-utils \
             /dist/packages/database /dist/packages/rabbitmq-client && \
    if [ -d /app/packages/shared-types/dist ]; then \
      cp -r /app/packages/shared-types/dist /dist/packages/shared-types/; \
    fi && \
    if [ -d /app/packages/shared-utils/dist ]; then \
      cp -r /app/packages/shared-utils/dist /dist/packages/shared-utils/; \
    fi && \
    if [ -d /app/packages/database/dist ]; then \
      cp -r /app/packages/database/dist /dist/packages/database/; \
    fi && \
    if [ -d /app/packages/rabbitmq-client/dist ]; then \
      cp -r /app/packages/rabbitmq-client/dist /dist/packages/rabbitmq-client/; \
    fi && \
    if [ -d /app/services/${SERVICE_NAME}/dist ]; then \
      mkdir -p /dist/services/${SERVICE_NAME} && \
      cp -r /app/services/${SERVICE_NAME}/dist /dist/services/${SERVICE_NAME}/; \
    fi && \
    if [ -d /app/apps/${SERVICE_NAME}/dist ]; then \
      mkdir -p /dist/apps/${SERVICE_NAME} && \
      cp -r /app/apps/${SERVICE_NAME}/dist /dist/apps/${SERVICE_NAME}/; \
    fi

# --- Stage 3: Production Runner ---
FROM node:20-alpine AS runner

ARG SERVICE_NAME
ARG SERVICE_PORT=4000
ENV NODE_ENV=production
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PORT=${SERVICE_PORT}

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

# Copy package files for production install
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/database/package.json ./packages/database/
COPY packages/rabbitmq-client/package.json ./packages/rabbitmq-client/
COPY services/auth-service/package.json ./services/auth-service/
COPY services/inventory-service/package.json ./services/inventory-service/
COPY services/supply-chain-service/package.json ./services/supply-chain-service/
COPY services/crm-service/package.json ./services/crm-service/
COPY services/notification-service/package.json ./services/notification-service/
COPY services/document-service/package.json ./services/document-service/
COPY apps/gateway/package.json ./apps/gateway/

# Install production dependencies only
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Copy built artifacts from dist-collector
COPY --from=dist-collector /dist/ ./

USER appuser

EXPOSE ${SERVICE_PORT}

# Start the service
CMD ["sh", "-c", "node services/${SERVICE_NAME}/dist/index.js 2>/dev/null || node apps/${SERVICE_NAME}/dist/index.js"]
