# =============================================================================
# Multi-stage Dockerfile for the React (Vite) frontend
# Build: docker build -f docker/Dockerfile.web --build-arg VITE_API_URL=https://api.realestate.example.com .
# =============================================================================

# --- Stage 1: Build ---
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package.json package-lock.json turbo.json tsconfig.base.json ./

# Copy workspace package.json files needed for resolution
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/database/package.json ./packages/database/
COPY packages/rabbitmq-client/package.json ./packages/rabbitmq-client/
COPY apps/web/package.json ./apps/web/

# Dummy service package.json (needed for workspace resolution)
COPY services/auth-service/package.json ./services/auth-service/
COPY services/inventory-service/package.json ./services/inventory-service/
COPY services/supply-chain-service/package.json ./services/supply-chain-service/
COPY services/crm-service/package.json ./services/crm-service/
COPY services/notification-service/package.json ./services/notification-service/
COPY services/document-service/package.json ./services/document-service/
COPY apps/gateway/package.json ./apps/gateway/

# Install dependencies
RUN npm ci --ignore-scripts

# Copy source
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Build arg for API URL (injected at build time)
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

# Build the frontend
RUN npm run build --workspace=@realestate/web

# --- Stage 2: NGINX ---
FROM nginx:1.27-alpine AS runner

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Non-root user (nginx alpine default is nginx user)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
